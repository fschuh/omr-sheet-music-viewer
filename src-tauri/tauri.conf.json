{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OMR Sheet Music Viewer",
  "version": "0.1.0",
  "identifier": "com.homr.sheetmusicviewer",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../webapp",
      "wait": false
    },
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../webapp"
    },
    "frontendDist": "../webapp/dist"
  },
  "app": {
    "windows": [
      {
        "title": "OMR Sheet Music Viewer",
        "width": 1400,
        "height": 900,
        "maximized": true,
        "minWidth": 900,
        "minHeight": 600,
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPCACHE/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
