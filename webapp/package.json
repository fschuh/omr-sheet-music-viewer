{
  "name": "homr-viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:piano-assets": "node ./tools/prepare-piano-assets.mjs",
    "prepare:listen-assets": "node ./tools/prepare-listen-assets.mjs",
    "predev": "npm run prepare:piano-assets && npm run prepare:listen-assets",
    "dev": "vite",
    "prebuild": "npm run prepare:piano-assets && npm run prepare:listen-assets",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "node ./tools/run-tests.mjs",
    "parity:note-geometry": "esbuild ./tools/note-geometry-parity/run.ts --bundle --platform=node --format=esm --external:react --external:react-dom --external:react-dom/server --external:react/jsx-runtime --outfile=./.test-dist/note-geometry-parity.mjs && node ./.test-dist/note-geometry-parity.mjs",
    "musicxml:render": "esbuild ./tools/musicxml-corpus/render.tsx --bundle --platform=node --format=esm --external:react --external:react-dom --external:react-dom/server --external:react/jsx-runtime --outfile=./.test-dist/musicxml-render.mjs && node ./.test-dist/musicxml-render.mjs",
    "musicxml:check": "esbuild ./tools/musicxml-corpus/check.ts --bundle --platform=node --format=esm --outfile=./.test-dist/musicxml-check.mjs && node ./.test-dist/musicxml-check.mjs"
  },
  "dependencies": {
    "@audio-samples/piano-harmonics": "^1.0.5",
    "@audio-samples/piano-pedals": "^1.0.5",
    "@audio-samples/piano-release": "^1.0.5",
    "@audio-samples/piano-velocity1": "^1.0.5",
    "@audio-samples/piano-velocity10": "^1.0.5",
    "@audio-samples/piano-velocity11": "^1.0.5",
    "@audio-samples/piano-velocity12": "^1.0.5",
    "@audio-samples/piano-velocity13": "^1.0.5",
    "@audio-samples/piano-velocity14": "^1.0.5",
    "@audio-samples/piano-velocity15": "^1.0.5",
    "@audio-samples/piano-velocity16": "^1.0.5",
    "@audio-samples/piano-velocity2": "^1.0.5",
    "@audio-samples/piano-velocity3": "^1.0.5",
    "@audio-samples/piano-velocity4": "^1.0.5",
    "@audio-samples/piano-velocity5": "^1.0.5",
    "@audio-samples/piano-velocity6": "^1.0.5",
    "@audio-samples/piano-velocity7": "^1.0.5",
    "@audio-samples/piano-velocity8": "^1.0.5",
    "@audio-samples/piano-velocity9": "^1.0.5",
    "@fschuh/piano-transcription-engine": "git+https://github.com/fschuh/piano-transcription-engine.git#cd485c67b4f08c3e3cce5804a950367af73b866c",
    "@lumikey/piano-fingering-model": "0.3.0",
    "@tauri-apps/api": "^2.11.1",
    "onnxruntime-web": "1.27.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tone": "^15.1.22"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "@xmldom/xmldom": "^0.8.13",
    "fflate": "^0.8.2",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  }
}
